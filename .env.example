# Copy this file to .env.local (for your laptop) or paste these into Vercel → Settings → Environment Variables.

# Postgres connection string. On Supabase: Connect → "Transaction pooler" URI (port 6543).
DATABASE_URL=postgres://user:password@host:6543/postgres

# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# The public address of the site, used in email links and the "Copy Slack link" button.
APP_URL=http://localhost:3000

# Email (optional; without it, no emails are sent and students are told to bookmark their status page).
# For a club Gmail: turn on 2-step verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Cocktail Club <yourclub@gmail.com>"
